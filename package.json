{
  "name": "goldensoft-env",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:cloud-api": "pnpm --filter @goldensoft/cloud-backend dev",
    "dev:cloud-ui": "pnpm --filter @goldensoft/cloud-dashboard dev",
    "dev:branch-api": "pnpm --filter @goldensoft/branch-backend dev",
    "dev:branch-ui": "pnpm --filter @goldensoft/branch-pos dev",
    "dev:branch": "pnpm --parallel --filter @goldensoft/branch-backend --filter @goldensoft/branch-pos dev",
    "dev:all": "pnpm --parallel --filter \"./apps/**\" dev",
    "db:seed": "pnpm --filter @goldensoft/branch-backend db:seed && pnpm --filter @goldensoft/cloud-backend db:seed",
    "tauri-branch-ui": "pnpm --filter @goldensoft/branch-pos tauri:dev",
    "tauri-branch-ui:build": "pnpm --filter @goldensoft/branch-pos tauri build"
  },
  "engines": {
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
